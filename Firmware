/*
  Smart Campus Dashboard
  ESP32-based monitoring starter program

  IMPORTANT:
  - Verify all GPIO assignments before use.
  - Sensor calibration values must be determined experimentally.
  - This starter does not implement certified electrical protection.
  - Test relay logic with a safe, low-voltage setup first.
*/

#include <Arduino.h>

// ---------- GPIO CONFIGURATION ----------
// Change these to match your actual wiring.
const int VOLTAGE_PIN = 34;  // Voltage sensor analog output
const int CURRENT_PIN = 35;  // Current sensor analog output
const int RELAY_PIN   = 26;  // Relay module input

// Example thresholds only. Calibrate for your setup.
const float VOLTAGE_LIMIT = 250.0;
const float CURRENT_LIMIT = 5.0;

// Replace these with calibration values from your sensors.
// These placeholder values are NOT valid calibration constants.
const float VOLTAGE_SCALE = 1.0;
const float CURRENT_SCALE = 1.0;

const bool RELAY_ACTIVE_LOW = true;

bool relayOn = false;

float readVoltage() {
  int raw = analogRead(VOLTAGE_PIN);

  // Placeholder conversion. Replace with a calibrated RMS calculation.
  float sensorValue = (raw / 4095.0f) * 3.3f;
  return sensorValue * VOLTAGE_SCALE;
}

float readCurrent() {
  int raw = analogRead(CURRENT_PIN);

  // Placeholder conversion. Replace with a calibrated current calculation.
  float sensorValue = (raw / 4095.0f) * 3.3f;
  return sensorValue * CURRENT_SCALE;
}

void setRelay(bool turnOn) {
  relayOn = turnOn;

  if (RELAY_ACTIVE_LOW) {
    digitalWrite(RELAY_PIN, turnOn ? LOW : HIGH);
  } else {
    digitalWrite(RELAY_PIN, turnOn ? HIGH : LOW);
  }
}

void setup() {
  Serial.begin(115200);

  analogReadResolution(12);
  pinMode(RELAY_PIN, OUTPUT);

  // Start with relay de-energized.
  setRelay(false);

  Serial.println("Smart Campus Dashboard - starting");
}

void loop() {
  float voltage = readVoltage();
  float current = readCurrent();

  // Meaningful power calculation requires correctly calibrated readings
  // and, for AC circuits, appropriate real-power measurement.
  bool abnormal = (voltage > VOLTAGE_LIMIT) ||
                  (current > CURRENT_LIMIT);

  // Example demonstration logic only; not a safety-rated trip function.
  setRelay(abnormal);

  Serial.println("--------------------------------");
  Serial.print("Voltage sensor value: ");
  Serial.println(voltage, 2);

  Serial.print("Current sensor value: ");
  Serial.println(current, 2);

  Serial.print("Relay: ");
  Serial.println(relayOn ? "ON" : "OFF");
  Serial.println("--------------------------------");

  delay(1000);
}
